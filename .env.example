# LXScale Environment Variables

# DeepSeek API key for AI-powered result analysis (optional)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# PostgreSQL connection URL for storing comprehensive survey results (optional)
# If not set, survey results are shown on screen but not persisted.
# Format: postgresql://user:password@host:5432/dbname
# Example: postgresql://lxscale:secret@localhost:5432/lxscale
DATABASE_URL=

# Google Search Console verification ID (optional)
GOOGLE_VERIFICATION_ID=
